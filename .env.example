TWELVEDATA_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CLI_DEFAULT_SYMBOL=XAU/USD
CLI_DEFAULT_TIMEFRAME=5min
CANDLE_COUNT=500
CANDLE_CLOSE_BUFFER_SECONDS=30
MIN_RISK_REWARD=1.5
SIGNAL_HORIZON_CANDLES=12
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
SQLITE_PATH=./data/tradebot.db

NVIDIA_REASONING_EFFORT=medium
NVIDIA_REASONING_BUDGET=1024
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=1.0
ADMIN_LISTEN_ADDR=127.0.0.1:8088
TELEGRAM_BOT_USERNAME=
# Telegram wallets are provisioned without an xpub. The legacy web-invoice HD-wallet
# flow requires WEB_BSC_XPUB and WEB_BSC_REFERENCE_ADDRESS only when explicitly enabled.
WEB_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
WEB_BSC_CHAIN_ID=56
WEB_BSC_CONFIRMATIONS=12
WEB_BSC_TEST_INVOICES_ENABLED=false
WEB_BSC_TEST_EMAIL=
WEB_PUBLIC_BASE_URL=
AI_CONFIG_MASTER_KEY=
TREASURY_MAINNET_ENABLED=false
