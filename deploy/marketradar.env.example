# Copy outside the repository to /opt/marketradar/secrets/marketradar.env
# and chmod 600. Never commit the populated file.
TWELVEDATA_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
AI_CONFIG_MASTER_KEY=

CLI_DEFAULT_SYMBOL=XAU/USD
CLI_DEFAULT_TIMEFRAME=5min
CANDLE_COUNT=500
CANDLE_CLOSE_BUFFER_SECONDS=30
MIN_RISK_REWARD=1.5
SIGNAL_HORIZON_CANDLES=12
NVIDIA_REASONING_EFFORT=medium
NVIDIA_REASONING_BUDGET=1024
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=1.0

WEB_PUBLIC_BASE_URL=https://radar.foxwd.tech
WEB_BSC_RPC_URL=
WEB_BSC_CHAIN_ID=56
WEB_BSC_CONFIRMATIONS=12
WEB_BSC_TEST_INVOICES_ENABLED=false
WEB_BSC_TEST_EMAIL=
TREASURY_MAINNET_ENABLED=false
TREASURY_TESTNET_ENABLED=false
TREASURY_SWEEP_ENABLED=false
